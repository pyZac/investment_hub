# Copy to .env and fill in. .env is gitignored — never commit real values.

NODE_ENV=development

# Matches the `postgres` service in docker-compose.yml when running via Docker.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/investment_hub?schema=public"

# --- Production only (Railway) — least-privilege roles, SCRUM-126 ---
# Prisma's datasource always reads the single `DATABASE_URL` var above (see
# prisma/schema.prisma) — it has no separate variable name for a second
# role. These two are documentation/reference values only, showing which
# connection string `DATABASE_URL` should actually hold in each context:
#
#   - APP_DATABASE_URL: the `app` role's connection string (see
#     scripts/db-setup.sql). Set this as `DATABASE_URL` on the `app` and
#     `worker` Railway services — least privilege, no DROP/ALTER/CREATE,
#     no UPDATE/DELETE on ledger_entries.
#   - MIGRATOR_DATABASE_URL: the `migrator` role's connection string. Set
#     this as `DATABASE_URL` only in the one-off environment/command that
#     runs `prisma migrate deploy` (Railway pre-deploy command, or a manual
#     `railway run` invocation) — never on the long-running app/worker
#     services themselves.
#
# Never set both at once as real `DATABASE_URL`/`APP_DATABASE_URL`/
# `MIGRATOR_DATABASE_URL` values in the same running service — see
# docs/runbook.md's "Least-privilege database roles" and "Running
# migrations" sections for exactly how/when each one is used.
APP_DATABASE_URL="postgresql://app:REPLACE_ME@REPLACE_ME:5432/investment_hub?schema=public"
MIGRATOR_DATABASE_URL="postgresql://migrator:REPLACE_ME@REPLACE_ME:5432/investment_hub?schema=public"

# Fixed named timezone for all business date logic — never a raw UTC offset.
TIMEZONE=Asia/Dubai

# Minimum withdrawal amount, in simulated currency units.
MIN_WITHDRAWAL=50

# Placeholders only — real rates live in versioned config tables from Phase 2+.
DEFAULT_DAILY_INTEREST_RATE_BP=0
DEFAULT_DIRECT_COMMISSION_RATE_BP=0

# Main admin account created by `prisma db seed`. Required — the seed script
# refuses to run without both set. Change the password after first login.
SEED_ADMIN_EMAIL=admin@investment-hub.local
SEED_ADMIN_PASSWORD=invest12345
