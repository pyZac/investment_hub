generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Locale {
  en
  ar
}

enum AdminPermission {
  CREDIT_ISSUANCE
  WITHDRAWAL_APPROVAL
  USER_MANAGEMENT
  PACKAGE_MANAGEMENT
  RATE_CONFIG
  COMMISSION_CONFIG
  RANK_CONFIG
  LEDGER_VIEW
  MANUAL_ADJUSTMENT
  JOB_MONITOR
  SOLVENCY_VIEW
}

enum AdminActionType {
  USER_CREATED
  PASSWORD_RESET
  CREDIT_ISSUANCE
  PACKAGE_CREATED
  PACKAGE_EDITED
  PACKAGE_DEACTIVATED
  USER_SUSPENDED
  USER_REINSTATED
}

enum SecurityEventType {
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_RESET_FAILED
  SECURITY_QUESTION_FAILED
  TOTP_ENROLLED
  TOTP_REMOVED
  TOTP_FAILED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String @map("password_hash")
  name         String

  role        UserRole @default(USER)
  isMainAdmin Boolean  @default(false) @map("is_main_admin")

  createdByAdminId  String? @map("created_by_admin_id")
  createdByAdmin    User?   @relation("AdminCreatedUsers", fields: [createdByAdminId], references: [id])
  adminCreatedUsers User[]  @relation("AdminCreatedUsers")

  sponsorId String? @map("sponsor_id")
  sponsor   User?   @relation("SponsorTree", fields: [sponsorId], references: [id])
  referrals User[]  @relation("SponsorTree")

  locale Locale @default(en)

  suspendedAt DateTime? @map("suspended_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  totpSecret     String?   @map("totp_secret")
  totpEnrolledAt DateTime? @map("totp_enrolled_at")

  permissionGrants AdminPermissionGrant[]

  adminActionsPerformed AdminAction[] @relation("AdminActionActor")
  adminActionsReceived  AdminAction[] @relation("AdminActionTarget")

  securityQuestions SecurityQuestion[]

  sessions Session[]

  pendingAuths PendingAuth[]

  securityEvents SecurityEvent[]

  ledgerEntries LedgerEntry[]

  walletAccounts WalletAccount[]

  investments Investment[]

  walletTransfers WalletTransfer[]

  withdrawalRequests        WithdrawalRequest[]
  withdrawalRequestsDecided WithdrawalRequest[] @relation("WithdrawalRequestDecidedBy")

  savingLots SavingLot[]

  binaryNode BinaryNode?

  binaryCycles BinaryCycle[]

  @@map("users")
}

enum Wallet {
  A
  B
  C
  SAVING
  SYSTEM_EXTERNAL
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerEntryType {
  ADMIN_CREDIT
  PACKAGE_PURCHASE
  DAILY_INTEREST
  DIRECT_COMMISSION
  DIRECT_SAVING
  BINARY_COMMISSION
  RANK_REWARD
  WITHDRAWAL_OUT
  WITHDRAWAL_IN
  CAPITAL_RELEASE
  SAVING_UNLOCK
  ADMIN_ADJUSTMENT
}

model LedgerEntry {
  id     String  @id @default(cuid())
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  wallet    Wallet
  direction LedgerDirection
  amount    Decimal         @db.Decimal(24, 8)

  entryType LedgerEntryType @map("entry_type")

  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  comment String?

  idempotencyKey String @map("idempotency_key")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Uniqueness on (idempotency_key, user_id, wallet, direction) is enforced by
  // a hand-written expression index in the
  // 20260813120000_ledger_composite_idempotency_key migration, using
  // COALESCE(user_id, 'SYSTEM_EXTERNAL') — Postgres treats every NULL as
  // distinct in a plain unique index, which would let two SYSTEM_EXTERNAL rows
  // (user_id IS NULL) with the same key/wallet/direction silently bypass
  // uniqueness. Prisma can't express a functional/expression index in the
  // schema DSL, so it is NOT declared here as @@unique — doing so would make
  // `prisma migrate dev`/`db push` try to (re)create a plain-column index that
  // conflicts with the real one. Do not add @@unique for this combination.
  @@index([userId, wallet])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

model WalletAccount {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  type    Wallet
  balance Decimal @default(0) @db.Decimal(24, 8)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, type])
  @@map("wallets")
}

model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?           @map("user_id")
  user      User?             @relation(fields: [userId], references: [id])
  email     String?
  ipAddress String?           @map("ip_address")
  detail    String?
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("security_events")
}

enum PendingAuthPurpose {
  TOTP_VERIFICATION
  TOTP_ENROLLMENT
}

model PendingAuth {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id])
  tokenHash String             @unique @map("token_hash")
  purpose   PendingAuthPurpose
  expiresAt DateTime           @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("pending_auths")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model SecurityQuestion {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  question   String
  answerHash String   @map("answer_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("security_questions")
}

model AdminPermissionGrant {
  id          String          @id @default(cuid())
  adminUserId String          @map("admin_user_id")
  adminUser   User            @relation(fields: [adminUserId], references: [id])
  permission  AdminPermission
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([adminUserId, permission])
  @@map("admin_permission_grants")
}

model Package {
  id            String    @id @default(cuid())
  name          String    @unique
  amount        Decimal   @db.Decimal(24, 8)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  deactivatedAt DateTime? @map("deactivated_at")

  adminActions AdminAction[]
  investments  Investment[]

  @@map("packages")
}

enum InvestmentStatus {
  ACTIVE
  CAPITAL_RELEASED
}

model Investment {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id])

  amount Decimal @db.Decimal(24, 8)

  purchasedAt       DateTime  @map("purchased_at")
  profitStartsAt    DateTime  @map("profit_starts_at")
  capitalUnlocksAt  DateTime  @map("capital_unlocks_at")
  capitalReleasedAt DateTime? @map("capital_released_at")

  status InvestmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")

  // Links back to the purchase's idempotencyKey (stored as referenceId on the
  // paired ledger entries) so a replayed purchase call can find the
  // already-created investment without needing its own idempotencyKey column.
  referenceId String? @unique @map("reference_id")

  bvEntries BvEntry[]

  @@index([userId])
  @@index([packageId])
  @@map("investments")
}

model InterestRateConfig {
  id            String    @id @default(cuid())
  monthlyRate   Decimal   @map("monthly_rate") @db.Decimal(24, 8)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  // Enforces "exactly one active rate at any moment" (Decision 4) at the DB
  // level: a partial unique index on a constant expression WHERE
  // effective_to IS NULL, hand-written across the
  // 20260816120000_add_interest_rate_config and
  // 20260816121500_fix_interest_rate_config_one_active_index migrations
  // (indexing effective_to itself doesn't work — NULL is never equal to NULL,
  // even in a partial index, so it can't catch a second active row). Prisma's
  // DSL can't express this, so it is NOT declared as @@unique here.
  @@map("interest_rate_config")
}

enum JobRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model JobRun {
  id          String       @id @default(cuid())
  jobType     String       @map("job_type")
  periodKey   String       @map("period_key")
  status      JobRunStatus
  startedAt   DateTime     @map("started_at")
  completedAt DateTime?    @map("completed_at")
  error       String?

  // Catch-up logic (Decision 2) asks "what periods are unprocessed?", never
  // "what is today?". One row per (job_type, period_key) — a period is only
  // ever retried in place (RUNNING -> COMPLETED/FAILED), never duplicated.
  @@unique([jobType, periodKey])
  @@map("job_runs")
}

enum TransferFromWallet {
  A
  C
}

model WalletTransfer {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  fromWallet TransferFromWallet @map("from_wallet")
  amount     Decimal            @db.Decimal(24, 8)

  requestedAt DateTime @map("requested_at")
  processedAt DateTime @map("processed_at")

  idempotencyKey String @unique @map("idempotency_key")

  @@index([userId])
  @@map("wallet_transfers")
}

enum WithdrawalRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

model WithdrawalRequest {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  amount Decimal                 @db.Decimal(24, 8)
  status WithdrawalRequestStatus @default(PENDING)

  requestedAt DateTime @map("requested_at")

  decidedAt        DateTime? @map("decided_at")
  decidedByAdminId String?   @map("decided_by_admin_id")
  decidedByAdmin   User?     @relation("WithdrawalRequestDecidedBy", fields: [decidedByAdminId], references: [id])
  adminComment     String?   @map("admin_comment")

  @@index([userId])
  @@index([status])
  @@map("withdrawal_requests")
}

model SavingLot {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  amount Decimal @db.Decimal(24, 8)

  // Nullable: nothing populates this until Phase 6's Direct Commission
  // creates saving_lots rows from the locked 3% split. No relation is
  // declared back on Investment (one-directional reference only) since
  // Phase 6 hasn't defined how that side should look yet.
  sourceInvestmentId String? @map("source_investment_id")

  createdAt  DateTime  @default(now()) @map("created_at")
  unlocksAt  DateTime  @map("unlocks_at")
  releasedAt DateTime? @map("released_at")

  @@index([userId])
  @@index([releasedAt, unlocksAt])
  @@map("saving_lots")
}

model CommissionConfig {
  id String @id @default(cuid())

  directRate            Decimal @map("direct_rate") @db.Decimal(24, 8)
  directCommissionSplit Decimal @map("direct_commission_split") @db.Decimal(24, 8)
  directSavingSplit     Decimal @map("direct_saving_split") @db.Decimal(24, 8)
  binaryRate            Decimal @map("binary_rate") @db.Decimal(24, 8)

  binaryCarryForwardExpiryMonths Int @default(6) @map("binary_carry_forward_expiry_months")

  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  // "At most one active row" (effective_to IS NULL) enforced by a hand-written
  // partial unique index on a constant expression — see
  // 20260821120000_add_commission_config/migration.sql and the identical
  // interest_rate_config pattern above (indexing effective_to itself doesn't
  // work; NULL is never equal to NULL even in a partial index). NOT declared
  // as @@unique here for the same reason as InterestRateConfig.
  @@map("commission_config")
}

enum BinaryPosition {
  LEFT
  RIGHT
}

// The placement tree (Decision: Part 3 "Two Separate Trees"). Independent from
// users.sponsor_id (the sponsor tree) — never join the two. userId is both the
// primary key and the 1:1 link to User, since every user has at most one node.
model BinaryNode {
  userId String @id @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  parentId String?         @map("parent_id")
  parent   BinaryNode?     @relation("BinaryTree", fields: [parentId], references: [userId])
  children BinaryNode[]    @relation("BinaryTree")
  position BinaryPosition?

  // Materialized path of ancestor user_ids, e.g. "/cuid1/cuid2/cuid3/" (root's
  // own segment included), for fast ancestor/descendant prefix queries without
  // a recursive CTE. Maintained on insert; never rewritten afterward since
  // nodes never move once placed.
  path  String
  depth Int

  // Cached totals of THIS node's own two legs (not the whole subtree below
  // it) — avoids summing the subtree on every placement/rollup read. Placed
  // here (SCRUM-70) at 0/0 for every new node; incremented by real amounts
  // only by BV rollup on purchase (SCRUM-71, per docs/mlm_rules_log.md
  // Section 5's BV definition — package purchases only, never profits/
  // commissions/rank rewards/transfers).
  leftBv  Decimal @default(0) @map("left_bv") @db.Decimal(24, 8)
  rightBv Decimal @default(0) @map("right_bv") @db.Decimal(24, 8)

  bvEntries BvEntry[]

  @@index([parentId])
  @@index([path])
  @@map("binary_nodes")
}

// One row per (ancestor, purchase) — the BV rollup this purchase generated
// for that specific ancestor's tree. Only real package purchases (including
// reinvestment) generate BV; never profits, commissions, rank rewards, or
// transfers (docs/mlm_rules_log.md Section 5). UNIQUE(ancestorUserId,
// sourceInvestmentId) is both the "one entry per ancestor per purchase"
// invariant and the replay guard — no separate idempotency key needed since
// this table has no money-movement side effect of its own.
model BvEntry {
  id String @id @default(cuid())

  ancestorUserId String     @map("ancestor_user_id")
  ancestor       BinaryNode @relation(fields: [ancestorUserId], references: [userId])

  sourceInvestmentId String     @map("source_investment_id")
  sourceInvestment   Investment @relation(fields: [sourceInvestmentId], references: [id])

  leg    BinaryPosition
  amount Decimal        @db.Decimal(24, 8)

  cycleWeekStart DateTime @map("cycle_week_start")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([ancestorUserId, sourceInvestmentId])
  @@index([cycleWeekStart])
  @@map("bv_entries")
}

// Weekly weak-leg payout snapshot, one row per user per cycle (Saturday
// 00:00 -> Friday 23:59, Asia/Dubai) — the audit record and UI data source
// for "why wasn't I paid" (docs/phases/phase-08-binary-cycle.md).
// leftVolume/rightVolume already include that week's carried-in balance
// (prior carryLeft/carryRight + BV rolled up this cycle), per
// docs/mlm_rules_log.md Section 5. Schema only for now — the cycle-close
// engine that populates these rows is a later ticket.
model BinaryCycle {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  weekStart DateTime @map("week_start")
  weekEnd   DateTime @map("week_end")

  leftVolume  Decimal @map("left_volume") @db.Decimal(24, 8)
  rightVolume Decimal @map("right_volume") @db.Decimal(24, 8)

  matchedVolume  Decimal @default(0) @map("matched_volume") @db.Decimal(24, 8)
  commissionPaid Decimal @default(0) @map("commission_paid") @db.Decimal(24, 8)

  // Leftover after matching, carried into next week's left_volume/
  // right_volume input. One of these is always 0 — the weaker leg resets,
  // the stronger leg's excess carries (Carry Forward rule).
  carryLeft  Decimal @default(0) @map("carry_left") @db.Decimal(24, 8)
  carryRight Decimal @default(0) @map("carry_right") @db.Decimal(24, 8)

  // week_start when the currently-carried balance first appeared unmatched;
  // reset to this cycle's week_start whenever that side fully matches down
  // to 0 (or is newly created carry). Null whenever the corresponding carry
  // is 0. Used to compute Carry Forward Expiry age against
  // commission_config.binaryCarryForwardExpiryMonths — only continuously
  // unmatched volume ages out.
  carryLeftSince  DateTime? @map("carry_left_since")
  carryRightSince DateTime? @map("carry_right_since")

  qualified Boolean @map("qualified")

  // Explains why the user wasn't paid (e.g. "left leg inactive"); left null
  // when qualified — nothing to explain on the payout path.
  qualificationReason String? @map("qualification_reason")

  // Distinct from the natural UNIQUE(user_id, week_start) below — a
  // dedicated key column matching the WalletTransfer/WithdrawalRequest
  // pattern elsewhere in this schema, per the phase brief's explicit
  // `binary:{user_id}:{week_start}` format.
  idempotencyKey String @unique @map("idempotency_key")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, weekStart])
  @@index([weekStart])
  @@map("binary_cycles")
}

model AdminAction {
  id              String          @id @default(cuid())
  adminId         String          @map("admin_id")
  admin           User            @relation("AdminActionActor", fields: [adminId], references: [id])
  actionType      AdminActionType @map("action_type")
  targetUserId    String?         @map("target_user_id")
  targetUser      User?           @relation("AdminActionTarget", fields: [targetUserId], references: [id])
  targetPackageId String?         @map("target_package_id")
  targetPackage   Package?        @relation(fields: [targetPackageId], references: [id])
  amount          Decimal?        @db.Decimal(24, 8)
  reason          String?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("admin_actions")
}
