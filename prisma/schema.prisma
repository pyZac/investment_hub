generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum Locale {
  en
  ar
}

enum AdminPermission {
  CREDIT_ISSUANCE
  WITHDRAWAL_APPROVAL
  USER_MANAGEMENT
  PACKAGE_MANAGEMENT
  RATE_CONFIG
  COMMISSION_CONFIG
  RANK_CONFIG
  LEDGER_VIEW
  MANUAL_ADJUSTMENT
  JOB_MONITOR
  SOLVENCY_VIEW
}

enum AdminActionType {
  USER_CREATED
  PASSWORD_RESET
  CREDIT_ISSUANCE
  PACKAGE_CREATED
  PACKAGE_EDITED
  PACKAGE_DEACTIVATED
}

enum SecurityEventType {
  LOGIN_FAILED
  ACCOUNT_LOCKED
  PASSWORD_RESET_FAILED
  SECURITY_QUESTION_FAILED
  TOTP_ENROLLED
  TOTP_REMOVED
  TOTP_FAILED
}

model User {
  id           String @id @default(cuid())
  email        String @unique
  passwordHash String @map("password_hash")
  name         String

  role        UserRole @default(USER)
  isMainAdmin Boolean  @default(false) @map("is_main_admin")

  createdByAdminId  String? @map("created_by_admin_id")
  createdByAdmin    User?   @relation("AdminCreatedUsers", fields: [createdByAdminId], references: [id])
  adminCreatedUsers User[]  @relation("AdminCreatedUsers")

  sponsorId String? @map("sponsor_id")
  sponsor   User?   @relation("SponsorTree", fields: [sponsorId], references: [id])
  referrals User[]  @relation("SponsorTree")

  locale Locale @default(en)

  suspendedAt DateTime? @map("suspended_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  totpSecret     String?   @map("totp_secret")
  totpEnrolledAt DateTime? @map("totp_enrolled_at")

  permissionGrants AdminPermissionGrant[]

  adminActionsPerformed AdminAction[] @relation("AdminActionActor")
  adminActionsReceived  AdminAction[] @relation("AdminActionTarget")

  securityQuestions SecurityQuestion[]

  sessions Session[]

  pendingAuths PendingAuth[]

  securityEvents SecurityEvent[]

  ledgerEntries LedgerEntry[]

  walletAccounts WalletAccount[]

  investments Investment[]

  @@map("users")
}

enum Wallet {
  A
  B
  C
  SAVING
  SYSTEM_EXTERNAL
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

enum LedgerEntryType {
  ADMIN_CREDIT
  PACKAGE_PURCHASE
  DAILY_INTEREST
  DIRECT_COMMISSION
  DIRECT_SAVING
  BINARY_COMMISSION
  RANK_REWARD
  WITHDRAWAL_OUT
  WITHDRAWAL_IN
  CAPITAL_RELEASE
  SAVING_UNLOCK
  ADMIN_ADJUSTMENT
}

model LedgerEntry {
  id     String  @id @default(cuid())
  userId String? @map("user_id")
  user   User?   @relation(fields: [userId], references: [id])

  wallet    Wallet
  direction LedgerDirection
  amount    Decimal         @db.Decimal(24, 8)

  entryType LedgerEntryType @map("entry_type")

  referenceType String? @map("reference_type")
  referenceId   String? @map("reference_id")

  comment String?

  idempotencyKey String @map("idempotency_key")

  metadata Json?

  createdAt DateTime @default(now()) @map("created_at")

  // Uniqueness on (idempotency_key, user_id, wallet, direction) is enforced by
  // a hand-written expression index in the
  // 20260813120000_ledger_composite_idempotency_key migration, using
  // COALESCE(user_id, 'SYSTEM_EXTERNAL') — Postgres treats every NULL as
  // distinct in a plain unique index, which would let two SYSTEM_EXTERNAL rows
  // (user_id IS NULL) with the same key/wallet/direction silently bypass
  // uniqueness. Prisma can't express a functional/expression index in the
  // schema DSL, so it is NOT declared here as @@unique — doing so would make
  // `prisma migrate dev`/`db push` try to (re)create a plain-column index that
  // conflicts with the real one. Do not add @@unique for this combination.
  @@index([userId, wallet])
  @@index([referenceType, referenceId])
  @@map("ledger_entries")
}

model WalletAccount {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  type    Wallet
  balance Decimal @default(0) @db.Decimal(24, 8)

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([userId, type])
  @@map("wallets")
}

model SecurityEvent {
  id        String            @id @default(cuid())
  type      SecurityEventType
  userId    String?           @map("user_id")
  user      User?             @relation(fields: [userId], references: [id])
  email     String?
  ipAddress String?           @map("ip_address")
  detail    String?
  createdAt DateTime          @default(now()) @map("created_at")

  @@index([email, createdAt])
  @@index([ipAddress, createdAt])
  @@map("security_events")
}

enum PendingAuthPurpose {
  TOTP_VERIFICATION
  TOTP_ENROLLMENT
}

model PendingAuth {
  id        String             @id @default(cuid())
  userId    String             @map("user_id")
  user      User               @relation(fields: [userId], references: [id])
  tokenHash String             @unique @map("token_hash")
  purpose   PendingAuthPurpose
  expiresAt DateTime           @map("expires_at")
  createdAt DateTime           @default(now()) @map("created_at")

  @@map("pending_auths")
}

model Session {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  user         User     @relation(fields: [userId], references: [id])
  tokenHash    String   @unique @map("token_hash")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("sessions")
}

model SecurityQuestion {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id])
  question   String
  answerHash String   @map("answer_hash")
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("security_questions")
}

model AdminPermissionGrant {
  id          String          @id @default(cuid())
  adminUserId String          @map("admin_user_id")
  adminUser   User            @relation(fields: [adminUserId], references: [id])
  permission  AdminPermission
  createdAt   DateTime        @default(now()) @map("created_at")

  @@unique([adminUserId, permission])
  @@map("admin_permission_grants")
}

model Package {
  id            String    @id @default(cuid())
  name          String    @unique
  amount        Decimal   @db.Decimal(24, 8)
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  deactivatedAt DateTime? @map("deactivated_at")

  adminActions AdminAction[]
  investments  Investment[]

  @@map("packages")
}

enum InvestmentStatus {
  ACTIVE
  CAPITAL_RELEASED
}

model Investment {
  id     String @id @default(cuid())
  userId String @map("user_id")
  user   User   @relation(fields: [userId], references: [id])

  packageId String  @map("package_id")
  package   Package @relation(fields: [packageId], references: [id])

  amount Decimal @db.Decimal(24, 8)

  purchasedAt       DateTime  @map("purchased_at")
  profitStartsAt    DateTime  @map("profit_starts_at")
  capitalUnlocksAt  DateTime  @map("capital_unlocks_at")
  capitalReleasedAt DateTime? @map("capital_released_at")

  status InvestmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")

  // Links back to the purchase's idempotencyKey (stored as referenceId on the
  // paired ledger entries) so a replayed purchase call can find the
  // already-created investment without needing its own idempotencyKey column.
  referenceId String? @unique @map("reference_id")

  @@index([userId])
  @@index([packageId])
  @@map("investments")
}

model InterestRateConfig {
  id            String    @id @default(cuid())
  monthlyRate   Decimal   @map("monthly_rate") @db.Decimal(24, 8)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")

  createdAt DateTime @default(now()) @map("created_at")

  // Enforces "exactly one active rate at any moment" (Decision 4) at the DB
  // level: a partial unique index on a constant expression WHERE
  // effective_to IS NULL, hand-written across the
  // 20260816120000_add_interest_rate_config and
  // 20260816121500_fix_interest_rate_config_one_active_index migrations
  // (indexing effective_to itself doesn't work — NULL is never equal to NULL,
  // even in a partial index, so it can't catch a second active row). Prisma's
  // DSL can't express this, so it is NOT declared as @@unique here.
  @@map("interest_rate_config")
}

enum JobRunStatus {
  RUNNING
  COMPLETED
  FAILED
}

model JobRun {
  id          String       @id @default(cuid())
  jobType     String       @map("job_type")
  periodKey   String       @map("period_key")
  status      JobRunStatus
  startedAt   DateTime     @map("started_at")
  completedAt DateTime?    @map("completed_at")
  error       String?

  // Catch-up logic (Decision 2) asks "what periods are unprocessed?", never
  // "what is today?". One row per (job_type, period_key) — a period is only
  // ever retried in place (RUNNING -> COMPLETED/FAILED), never duplicated.
  @@unique([jobType, periodKey])
  @@map("job_runs")
}

model AdminAction {
  id              String          @id @default(cuid())
  adminId         String          @map("admin_id")
  admin           User            @relation("AdminActionActor", fields: [adminId], references: [id])
  actionType      AdminActionType @map("action_type")
  targetUserId    String?         @map("target_user_id")
  targetUser      User?           @relation("AdminActionTarget", fields: [targetUserId], references: [id])
  targetPackageId String?         @map("target_package_id")
  targetPackage   Package?        @relation(fields: [targetPackageId], references: [id])
  amount          Decimal?        @db.Decimal(24, 8)
  reason          String?
  createdAt       DateTime        @default(now()) @map("created_at")

  @@map("admin_actions")
}
